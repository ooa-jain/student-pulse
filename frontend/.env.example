# Leave blank when FastAPI serves the built app (same origin).
# Set to the API origin only if you deploy the frontend separately.
VITE_API_BASE=

# Avatars: leave unset to use the DiceBear adventurer-neutral faces (default).
# Set to "local" to draw them in-app instead — useful if the campus network
# blocks api.dicebear.com. Either way a blocked request falls back automatically.
VITE_AVATAR_SOURCE=
